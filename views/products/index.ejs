
 <%layout('layouts/bollerplate')%>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %> 

<!-- Categories portion -->
<div class="py-3 py-md-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h4 class="mb-4">Our Categories</h4>
            </div>
            <div id="categoryCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="row">
                            <div class="col-6 col-md-3">
                                <div class="category-card">
                                    <a href="/products/category?category=sports">
                                        <div class="category-card-img">
                                            <img src="images/sports.jpeg" class="w-100" alt="Mobile">
                                        </div>
                                        <div class="category-card-body">
                                            <h5>Sports</h5>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="category-card">
                                    <a href="/products/category?category=mobile">
                                        <div class="category-card-img">
                                            <img src="images/phone.jpeg" class="w-100" alt="Mobile">
                                        </div>
                                        <div class="category-card-body">
                                            <h5>Mobile</h5>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="category-card">
                                    <a href="/products/category?category=men">
                                        <div class="category-card-img">
                                            <img src="images/men-cloths.jpeg" class="w-100" alt="Mens Fashion">
                                        </div>
                                        <div class="category-card-body">
                                            <h5>Mens Fashion</h5>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="category-card">
                                    <a href="/products/category?category=women">
                                        <div class="category-card-img">
                                            <img src="images/women.jpeg" class="w-100" alt="Women Fashion">
                                        </div>
                                        <div class="category-card-body">
                                            <h5>Women Fashion</h5>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Additional carousel items can be added here if needed -->
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#categoryCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#categoryCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
</div>




<!-- Products portion -->
<div class="py-3 py-md-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h4 class="mb-4">Our Products</h4>
            </div>
            <% for(let i of products){ %>
                <div class="col-md-3">
                <div class="product-card">
                    <div class="product-card-img">
                        <label class="stock bg-success">In Stock</label>
                        <img src="<%=i.img %>" alt="Laptop">
                    </div>
                    <div class="product-card-body">
                        <p class="product-brand"><%=i.brand%></p>
                        <h5 class="product-name">
                           <a href="">
                               <%=i.name%> 
                            </a>
                        </h5>
                        <div>
                            <span class="selling-price">$<%=i.price%></span>
                            <span class="original-price">$<%=i.originalprice%></span>
                        </div>
                        <div class="mt-2">
                            <form action="/user/<%=i._id%>/add" method="POST" class="d-inline-block">
                                <button type="submit" class="btn btn1">Add To cart</button>
                            </form>
                            <a href="" class="btn btn1"> <i class="fa fa-heart"></i> </a>
                            <a href="/products/<%=i._id%>" class="btn btn1"> View </a>
                            <% if(currentUser && currentUser.role==='seller' ){ %>
                                <form class="d-inline-block" action="/products/<%=i._id%>?_method=DELETE" method="post">
                                    <button class="btn btn1" type="submit">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>


