<%layout('layouts/bollerplate')%>
<%- include('../partials/navbar') %>

<% if(currentUser.cart.length > 0) { %>
 <div class="py-3 py-md-5 bg-light">
 <div class="container">
    <div class="row">
       <% for(let item of user.cart){ %>
        <div class="col-md-3">
            <div class="product-card">
                <div class="product-card-img">
                    <label class="stock bg-success">In Stock</label>
                    <img src="<%=item.img %>" alt="Laptop">
                </div>
                <div class="product-card-body">
                    <p class="product-brand">HP</p>
                    <h5 class="product-name">
                       <a href="">
                           <%=item.name%> 
                        </a>
                    </h5>
                    <div>
                        <span class="selling-price">$<%=item.price%></span>
                        <span class="original-price">$799</span>
                    </div>
                    <div class="mt-2">
                        <a href="" class="btn btn1"> <i class="fa fa-heart"></i> </a>
                        <a href="/products/<%=item._id%>" class="btn btn1"> View </a>
                        <!-- <a href="/products/<%=item._id%>" class="btn btn1"> View </a> -->
                        <form action="/user/remove/<%=item._id%>?_method=DELETE" method="POST" class="d-inline-block">
                            <button type="submit" class="btn btn-danger btn1"> <i class="fa fa-trash"></i> Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        </div>
        </div>
        </div>
       <% } %>
       <% } else { %>
        <div class="py-3 py-md-5 bg-light">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <h2>No products in your Cart</h2>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
    